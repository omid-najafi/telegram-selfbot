# Telegram API credentials — get from https://my.telegram.org/apps
API_ID=
API_HASH=

# Bot token — create a bot with @BotFather
BOT_TOKEN=

# Your Telegram user ID (numeric) — get from @userinfobot
OWNER_ID=

# Session string — leave EMPTY on first deploy.
# After /start login in bot, copy the printed string here and redeploy.
SESSION_STRING=

# Send interval in seconds (default 300 = 5 minutes)
SEND_INTERVAL=300
